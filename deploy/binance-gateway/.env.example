# DNS must point this hostname to the VPS before Caddy can issue TLS.
GATEWAY_DOMAIN=api.fuelbtc.com

# Generate on the VPS with: openssl rand -hex 32
# Store the same value as BINANCE_GATEWAY_SECRET in Supabase secrets.
GATEWAY_SHARED_SECRET=replace-with-at-least-32-random-characters

# Safe defaults for the first deployment.
READ_ONLY=true
ALLOW_TRADING=false
ALLOW_WITHDRAWALS=false
UPSTREAM_TIMEOUT_MS=15000
MAX_RESPONSE_BYTES=2097152
RATE_LIMIT_PER_MINUTE=300
